// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  nameIt      String?  // Italian name
  description String
  descriptionIt String?
  category    String   // appetizer, main, dessert, drink
  price       Float
  image       String?
  allergens   String?  // JSON string of allergens
  vegan       Boolean  @default(false)
  glutenFree  Boolean  @default(false)
  vegetarian  Boolean  @default(false)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Reservation {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String
  date          DateTime
  time          String
  partySize     Int
  specialRequests String?
  status        String   @default("pending") // pending, confirmed, cancelled
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  titleIt     String?
  slug        String   @unique
  excerpt     String
  excerptIt   String?
  content     String
  contentIt   String?
  image       String?
  category    String   // recipe, news, event
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  name      String
  email     String?
  rating    Int      // 1-5
  comment   String
  source    String   @default("website") // website, google, yelp
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id          String   @id @default(cuid())
  customerName String
  email       String
  phone       String
  items       String   // JSON string of items
  total       Float
  status      String   @default("pending") // pending, confirmed, preparing, ready, completed, cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  subscribed Boolean @default(true)
  createdAt DateTime @default(now())
}

